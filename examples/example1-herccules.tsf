-- Converted from example1-herccules.py; all times are milliseconds.
-- Original synchronization protocol: PIP (selected on the command line).
-- Fields: priority, period, offset, jitter, wcet, blocking, interference, deadline, response.
-- Offset and jitter are zero, as in the original model.
-- Interference and response are zero placeholders, not analysis results.
-- Bare lock declarations leave ceilings for the analyzer to compute.
-- Blocking reproduces the original rta.py PIP calculation:
--   For each lock with a user at priority >= p and a user at priority < p,
--   add the maximum critical-section duration across ALL users of that lock.
-- These legacy estimates are not independently justified general PIP bounds.
-- Use -pb --protocol PIP to retain priorities and these blocking values.
-- Do not omit -p: a changed priority order requires recomputing blocking.
-- Do not omit -b: automatic PIP blocking is not supported by this analyzer.
-- WARNING: Source priorities are NOT distinct and are intentionally preserved.
-- The guide-based analyzer rejects this file in manual-priority mode.
-- A real scheduling/tie-breaking policy must be supplied before analysis.
-- Changing priorities makes a different model; its blocking must be recomputed.
-- Repeated priority 3: TC_Handler, Event Handler, SDPU Measurer.
-- Repeated priority 2: TC Receiver, TM Sender.
-- The overwritten initial DP-PCU object is not in the source solver.
-- The repeated dp_pcu set entry denotes the same final object (one lock).

task set HERCCULES with 9 tasks and 17 locks is

  -- Protected objects
  lock NADS-Mode;
  lock HTL-Mode;
  lock HTL-Ctrlr;
  lock SDPU-Mode;
  lock SDPU-Ctrlr;
  lock EL-Ctrlr;
  lock PCU-Mode;
  lock PCU-Dev;
  lock TTC-Mode;
  lock TTC-TM-Mode;
  lock Event-Queue;
  lock TC-Queue;
  lock DP-NADS;
  lock DP-PCU;
  lock DP-HTL;
  lock DP-EL;
  lock DP-ATL;

  -- Tasks
  task TC_Handler is sporadic (3, 1000, 0, 0, 60.35, 4.66, 0, 500, 0)
    uses TC-Queue (0.03),
         NADS-Mode (0.03),
         HTL-Mode (0.05),
         HTL-Ctrlr (0.8),
         SDPU-Mode (0.05),
         EL-Ctrlr (2.3),
         PCU-Mode (0.04),
         PCU-Dev (1.4),
         TTC-Mode (0.04),
         TTC-TM-Mode (0.04);

  -- Original task name: Event Handler
  task Event_Handler is sporadic (3, 1000, 0, 0, 53.5, 4.66, 0, 500, 0)
    uses Event-Queue (3),
         NADS-Mode (0.03),
         HTL-Mode (0.06),
         HTL-Ctrlr (2.8),
         PCU-Mode (0.04),
         SDPU-Mode (0.05),
         EL-Ctrlr (1.3),
         TTC-Mode (0.04);

  -- Original task name: TC Receiver
  task TC_Receiver is periodic (2, 1000, 0, 0, 90.2, 1.47, 0, 1000, 0)
    uses Event-Queue (0.03),
         TTC-TM-Mode (0.04),
         TC-Queue (0.03);

  -- Original task name: TM Sender
  task TM_Sender is periodic (2, 1000, 0, 0, 78.33, 1.47, 0, 1000, 0)
    uses Event-Queue (0.03),
         TTC-TM-Mode (0.04),
         TTC-Mode (0.04),
         DP-NADS (0.02),
         DP-HTL (0.03),
         DP-EL (0.03),
         DP-PCU (0.03),
         DP-ATL (0.03);

  -- Original task name: IMU Measurer
  task IMU_Measurer is periodic (6, 10, 0, 0, 3, 0.05, 0, 10, 0)
    uses NADS-Mode (0.03),
         DP-NADS (0.02);

  -- Original task name: GPS Measurer
  task GPS_Measurer is periodic (5, 200, 0, 0, 24, 0.05, 0, 200, 0)
    uses NADS-Mode (0.03),
         DP-NADS (0.02);

  -- Original task name: HTL Manager
  task HTL_Manager is periodic (4, 10000, 0, 0, 43, 2.97, 0, 10000, 0)
    uses HTL-Mode (0.06),
         HTL-Ctrlr (2.8),
         DP-HTL (0.03),
         DP-EL (0.03);

  -- Original task name: SDPU Measurer
  task SDPU_Measurer is periodic (3, 1000, 0, 0, 38, 4.66, 0, 1000, 0)
    uses Event-Queue (0.03),
         SDPU-Mode (0.05),
         SDPU-Ctrlr (0.7),
         DP-ATL (0.03),
         DP-EL (0.03),
         EL-Ctrlr (1.3);

  -- Original task name: PCU Manager
  task PCU_Manager is periodic (1, 5000, 0, 0, 33, 0, 0, 5000, 0)
    uses PCU-Mode (0.04),
         DP-PCU (0.03),
         PCU-Dev (1.4);

end HERCCULES;
